# WGDashboard container environment.
# More info at https://docs.wgdashboard.dev/install/Docker.html

# Change this value to your preferred time zone.
tz=Europe/Madrid

# Web interface account. Applied on every start of the container, so changes
# made from the web interface are overwritten by these values.
username=admin
password=change-me
# Two-factor authentication is enabled from the web interface settings, where
# the QR code is scanned. Do not set enable_totp here: setting it to true asks
# for a code from a key that was never registered, and any value overwrites
# the one chosen in the web interface on every start.

# DNS servers given to the VPN clients (e.g. the Pi-hole host IP).
global_dns=208.67.222.222

# Public IP or domain (e.g. the DDNS one) used as endpoint in the client
# configurations.
# Auto-detected if not set.
#public_ip=

# WireGuard interface started with the container.
wg_autostart=wg0
